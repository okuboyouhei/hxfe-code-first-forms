msgid "Thank you! Your message has been sent."
msgstr "ありがとうございます。メッセージを送信しました。"

msgid "Thank you for contacting %s"
msgstr "%s へのお問い合わせありがとうございます"

msgid "New form submission"
msgstr "フォーム送信"

msgid "New submission from %s"
msgstr "%s からの新規送信"

msgid "This field is required."
msgstr "この項目は必須です。"

msgid "Invalid email address."
msgstr "メールアドレスの形式が正しくありません。"

msgid "Invalid selection."
msgstr "選択内容が正しくありません。"

msgid "Invalid request. Please try again."
msgstr "不正なリクエストです。もう一度お試しください。"

msgid "Please correct the errors below."
msgstr "入力内容にエラーがあります。ご確認ください。"

msgid "Please review your submission."
msgstr "入力内容をご確認ください。"

msgid "Please complete the reCAPTCHA verification."
msgstr "reCAPTCHA の確認を完了してください。"

msgid "reCAPTCHA verification failed. Please try again."
msgstr "reCAPTCHA の確認に失敗しました。もう一度お試しください。"

msgid "reCAPTCHA score too low. Please try again."
msgstr "reCAPTCHA のスコアが低すぎます。もう一度お試しください。"

msgid "File size exceeds the maximum of %sMB."
msgstr "ファイルサイズが上限の %sMB を超えています。"

msgid "File type is not allowed."
msgstr "このファイル形式は許可されていません。"

msgid "File upload failed. Please try again."
msgstr "ファイルのアップロードに失敗しました。もう一度お試しください。"

msgid "File upload failed: "
msgstr "ファイルアップロードエラー: "

msgid "(No file)"
msgstr "（ファイルなし）"

msgid "Max file size: %sMB"
msgstr "最大ファイルサイズ: %sMB"

msgid "This form is not available from your network."
msgstr "このフォームはご利用いただけません。"

msgid "This form is not yet available."
msgstr "このフォームはまだ受付を開始していません。"

msgid "This form is now closed."
msgstr "このフォームの受付は終了しました。"

msgid "Too many failed attempts. Please wait 15 minutes and try again."
msgstr "ログイン試行回数が上限を超えました。15分後に再度お試しください。"

msgid "Login required"
msgstr "ログインが必要です"

msgid "Login"
msgstr "ログイン"

msgid "ID"
msgstr "ID"

