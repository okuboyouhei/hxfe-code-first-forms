msgstr "%d 件のフォームが登録されています"

msgid "No forms registered yet."
msgstr "フォームがまだ登録されていません。"

msgid "Add schemas via the hxfe_schemas filter in functions.php."
msgstr "functions.php の hxfe_schemas フィルターでスキーマを追加してください。"

msgid "Forms are defined via the hxfe_schemas filter. Edit in functions.php (or a separate file) and reload this page."
msgstr "フォームは hxfe_schemas フィルターで定義します。functions.php（または別ファイル）を編集してこのページをリロードしてください。"

msgid "Schema Examples"
msgstr "スキーマサンプル"

msgid "Copy and paste into functions.php (or a separate file). Change the id, to, and field labels as needed."
msgstr "functions.php（または別ファイル）にコピー&ペーストしてください。id・to・ラベルは適宜変更してください。"

msgid "① Basic form"
msgstr "① 基本フォーム"

msgid "② Step form"
msgstr "② ステップフォーム"

msgid "③ One-by-one (survey)"
msgstr "③ 1問1答（アンケート）"

msgid "④ Chatbot"
msgstr "④ チャットbot"

msgid "⑤ Conditional fields"
msgstr "⑤ 条件分岐"

msgid "⑥ File upload"
msgstr "⑥ ファイルアップロード"

msgid "⑦ Password-protected form (auth can be added to any form)"
msgstr "⑦ パスワード認証（どのフォームにも追加できます）"

msgid "⑧ Download after submit (document request)"
msgstr "⑧ 送信後ダウンロード（資料請求）"

msgid "⑨ Form availability window (open/close date)"
msgstr "⑨ 公開期間設定（開始・終了日時）"

msgid "SMTP Settings"
msgstr "SMTP 設定"

msgid "Enable SMTP"
msgstr "SMTP を有効にする"

msgid "Send all WordPress emails via SMTP"
msgstr "WordPress のメールをすべて SMTP 経由で送信する"

msgid "Custom SMTP"
msgstr "カスタム SMTP"

msgid "SMTP Host"
msgstr "SMTP ホスト"

msgid "Encryption"
msgstr "暗号化"

msgid "Username"
msgstr "ユーザー名"

msgid "From Email"
msgstr "送信元メールアドレス"

msgid "From Name"
msgstr "送信者名"

msgid "Must match the authenticated sender domain (DKIM/SPF)."
msgstr "DKIM/SPF で認証された送信ドメインと一致させてください。"

msgid "Send Test Email"
msgstr "テストメール送信"

msgid "Send Test"
msgstr "送信テスト"

msgid "Test email sent successfully."
msgstr "テストメールを送信しました。"

msgid "Failed to send test email. Check your SMTP settings."
msgstr "テストメールの送信に失敗しました。SMTP設定を確認してください。"

msgid "Save SMTP Settings"
msgstr "SMTP 設定を保存"

msgid "Disable default CSS globally"
msgstr "デフォルト CSS を無効化する（全フォーム）"

msgid "Do not load hxfe-forms.css on any form"
msgstr "どのフォームでも hxfe-forms.css を読み込まない"

msgid "iframe / CORS"
msgstr "iframe / CORS"

msgid "iframe CORS is configured per-form via the"
msgstr "iframe の CORS 設定はフォームごとに"

msgid "schema key. Use the Schema Examples panel on the Forms page to get started."
msgstr "スキーマキーで設定します。フォームページのスキーマサンプルを参照してください。"

msgid "Standalone iframe URL:"
msgstr "スタンドアロン iframe URL:"

msgid "Save reCAPTCHA Settings"
msgstr "reCAPTCHA 設定を保存"

msgid "reCAPTCHA"
msgstr "reCAPTCHA"

msgid "v2 Site Key"
msgstr "v2 サイトキー"

msgid "v2 Secret Key"
msgstr "v2 シークレットキー"

msgid "v3 Site Key"
msgstr "v3 サイトキー"

msgid "v3 Secret Key"
msgstr "v3 シークレットキー"

msgid "v3 Score Threshold"
msgstr "v3 スコアしきい値"

msgid "0.1 (most permissive) – 1.0 (most strict). Default: 0.5"
msgstr "0.1（最も緩い）〜 1.0（最も厳しい）。デフォルト: 0.5"

msgid "Get your keys at"
msgstr "キーの取得先:"

msgid "Save Privacy Settings"
msgstr "プライバシー設定を保存"

msgid "Site-wide default. Can be overridden per-field in the schema."
msgstr "サイト全体のデフォルト設定です。スキーマの各フィールドで上書きできます。"

msgid "Direct URL or media library PDF URL."
msgstr "直接URLまたはメディアライブラリのPDF URLを指定してください。"

msgid "Form not found."
msgstr "フォームが見つかりません。"

msgid "[%s] SMTP test email"
msgstr "[%s] SMTP テストメール"

msgid "SMTP is configured correctly.\n\nSent from: %1$s\nTime: %2$s"
msgstr "SMTP の設定は正常です。\n\n送信元: %1$s\n送信日時: %2$s"

msgid "Thank you for your message.\nWe will get back to you as soon as possible."
msgstr "お問い合わせありがとうございます。\n内容を確認次第、折り返しご連絡いたします。"

msgid "HXFE_SMTP_PASSWORD is defined in wp-config.php and takes priority."
msgstr "wp-config.php に HXFE_SMTP_PASSWORD が定義されており、そちらが優先されます。"

msgid "HXFE_SMTP_API_KEY is defined in wp-config.php and takes priority."
msgstr "wp-config.php に HXFE_SMTP_API_KEY が定義されており、そちらが優先されます。"

msgid "Recommended: define HXFE_SMTP_PASSWORD in wp-config.php instead of storing here."
msgstr "推奨: ここに保存するのではなく、wp-config.php に HXFE_SMTP_PASSWORD として定義してください。"

msgid "Same as Gmail. Username = full email address."
msgstr "Gmail と同じ設定です。ユーザー名にはメールアドレス全体を入力してください。"

msgid "Use an App Password (not your Google account password). Enable 2FA first."
msgstr "Googleアカウントのパスワードではなく、アプリパスワードを使用してください。事前に2段階認証を有効にしてください。"

msgid "Enter your SMTP server details manually."
msgstr "SMTPサーバーの詳細を手動で入力してください。"

msgid "Username = postmaster@YOUR_DOMAIN. Password = Mailgun SMTP password."
msgstr "ユーザー名: postmaster@YOUR_DOMAIN。パスワード: Mailgun の SMTP パスワード。"

msgid "Username must be \"apikey\" (literally). Password = your SendGrid API key. Or set HXFE_SMTP_API_KEY in wp-config.php."
msgstr "ユーザー名は \"apikey\" と入力してください。パスワードは SendGrid の APIキーです。または wp-config.php に HXFE_SMTP_API_KEY を設定してください。"

msgid "Online"
msgstr "オンライン"

msgid "⑩ Diagnosis chatbot (no email, result only)"
msgstr "⑩ 診断チャットbot（メール送信なし・結果のみ表示）"

msgid "⑪ Custom validation (pattern / cross-field)"
msgstr "⑪ カスタムバリデーション（パターン / フォーム全体）"

msgid "The format is invalid."
msgstr "形式が正しくありません。"

msgid "Please enter at least %d character."
msgstr "%d文字以上入力してください。"

msgid "Please enter at least %d characters."
msgstr "%d文字以上入力してください。"

msgid "Please enter no more than %d character."
msgstr "%d文字以内で入力してください。"

msgid "Please enter no more than %d characters."
msgstr "%d文字以内で入力してください。"
